{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifeagent.local/schemas/goal-plan.schema.json",
  "title": "GoalPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "target_date", "metrics", "milestones"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target_value", "unit"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "target_value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "target_date"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "target_date": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
